// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  APPLICANT
  BPLO
  SUPER_ADMIN
  DEPARTMENT_HEAD
  JIT
}

enum ApplicationType {
  NEW
  RENEWAL
  CLOSURE
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  DEPARTMENT_HEAD_REVIEW
  DEPARTMENT_HEAD_APPROVED
  ASSESSED
  APPROVED_FOR_PAYMENT
  PAID
  FOR_RELEASE
  RELEASED
  REVOCATION_REVIEW
  REVOKED
  RETURNED_FOR_CORRECTION
  REJECTED
}

enum NonComplianceType {
  GOVERNMENT_AGENCY_RELATED
  RENEWAL_RELATED
}

enum ViolationSeverity {
  MINOR
  MAJOR
  SEVERE
}

enum ComplianceCaseStatus {
  NONE
  FLAGGED_UNSETTLED
  SETTLED
  EXPIRED_UNSETTLED
  FORCED_CLOSURE_PENDING
  CLOSED_NON_COMPLIANT
}

enum ClosureType {
  RETIREMENT
  NON_COMPLIANT_RELATED
  OTHERS
}

enum DocumentValidationStatus {
  PENDING_REVIEW
  VALID
  INVALID
  INCOMPLETE
  REQUIRES_RESUBMISSION
}

model User {
  userId                  String                 @id @default(cuid())
  email                   String                 @unique
  name                    String
  firstName               String?
  middleName              String?
  lastName                String?
  suffix                  String?
  profileImageStoragePath String?
  profileImageBucket      String?
  profileImageMimeType    String?
  profileImageSizeBytes   Int?
  profileImageUploadedAt  DateTime?
  passwordHash            String
  role                    Role                   @default(APPLICANT)
  isActive                Boolean                @default(true)
  applications            BusinessApplication[]  @relation("ApplicantApplications")
  businessRecords         BusinessRecord[]
  submittedLocations      BusinessLocation[]     @relation("LocationSubmittedBy")
  verifiedLocations       BusinessLocation[]     @relation("LocationVerifiedBy")
  historyEntries          ApplicationHistory[]   @relation("HistoryActor")
  assessmentsComputed     FeeAssessment[]        @relation("AssessmentComputedBy")
  reviewedPaymentReferences PaymentReference[]   @relation("PaymentReviewedBy")
  permitsPrepared         PermitIssuance[]       @relation("PermitPreparedBy")
  permitsReleased         PermitIssuance[]       @relation("PermitReleasedBy")
  inspections             Inspection[]           @relation("InspectionInspector")
  inspectionDecisions     Inspection[]           @relation("InspectionDecider")
  revocationSettlementRecords Inspection[]       @relation("InspectionRevocationSettledBy")
  complianceSettlementRecords Inspection[]       @relation("InspectionSettledBy")
  forcedClosureRecords    Inspection[]           @relation("InspectionForcedClosureBy")
  feeConfigurationUpdates FeeConfigurationItem[] @relation("FeeConfigUpdatedBy")
  systemFeeSettingUpdates SystemFeeSetting[]     @relation("SystemFeeSettingUpdatedBy")
  renewalExtensionUpdates RenewalExtension[]     @relation("RenewalExtensionUpdatedBy")
  smsDeliveryLogs         SmsDeliveryLog[]       @relation("SmsDeliveryLogApplicant")
  reassessmentRequests    FeeAssessment[]        @relation("FeeAssessmentReassessmentRequestedBy")
  jitNoPermitRecords      JitNoPermitRecord[]    @relation("JitNoPermitRecordCreatedBy")
  validatedDocuments      ApplicationDocument[]  @relation("DocumentValidatedBy")
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
}
  
model BusinessRecord {
  businessRecordId            String               @id @default(cuid())
  applicantId                 String
  businessType                String
  registrationNumber          String               @unique
  tin                         BigInt
  businessName                String
  tradeName                   String
  ownerName                   String
  ownerFirstName              String?
  ownerMiddleName             String?
  ownerLastName               String?
  ownerSuffix                 String?
  sex                         String?
  nationality                 String
  email                       String
  phone                       String
  mainOfficeAddress           String
  businessAddress             String
  sameAsMainOffice            Boolean              @default(true)
  businessArea                Decimal?             @db.Decimal(10, 2)
  totalFloorArea              Decimal?             @db.Decimal(10, 2)
  totalEmployees              Int?
  maleEmployees               Int?
  femaleEmployees             Int?
  employeesWithinMunicipality Int?
  deliveryVehicles            Int?
  propertyOwnership           String?
  taxDeclarationNumber        String?
  propertyIdentificationNumber String?
  taxIncentives               String?
  businessActivity            String?
  lineOfBusiness              String?
  assetSize                   Decimal?             @db.Decimal(10, 3)
  isMarket                    Boolean              @default(false)
  isAgriculture               Boolean              @default(false)
  permitExpirationDate        DateTime?
  businessStatus              BusinessRecordStatus @default(ACTIVE)
  closedAt                    DateTime?
  closureApplicationId        String?
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  applicant    User                  @relation(fields: [applicantId], references: [userId], onDelete: Cascade)
  applications BusinessApplication[]
  location     BusinessLocation?
  inspections  Inspection[]

  @@index([applicantId])
}

enum BusinessRecordStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum BusinessLocationStatus {
  PENDING
  VERIFIED
  NEEDS_CORRECTION
}

model BusinessLocation {
  businessLocationId String                 @id @default(cuid())
  businessRecordId   String                 @unique
  latitude           Float
  longitude          Float
  address            String?
  barangay           String?
  status             BusinessLocationStatus @default(PENDING)
  submittedById      String
  verifiedById       String?
  remarks            String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  businessRecord BusinessRecord @relation(fields: [businessRecordId], references: [businessRecordId], onDelete: Cascade)
  submittedBy    User           @relation("LocationSubmittedBy", fields: [submittedById], references: [userId], onDelete: Restrict)
  verifiedBy     User?          @relation("LocationVerifiedBy", fields: [verifiedById], references: [userId], onDelete: SetNull)

  @@index([status])
  @@index([submittedById])
  @@index([verifiedById])
}

model BusinessApplication {
  businessApplicationId  String            @id @default(cuid())
  applicationNumber      String            @unique
  applicantId            String
  businessRecordId       String?
  applicationType        ApplicationType
  status                 ApplicationStatus @default(DRAFT)
  formData               Json
  closureType            ClosureType?
  closureTypeOtherReason String?
  submittedAt            DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  applicant         User                  @relation("ApplicantApplications", fields: [applicantId], references: [userId], onDelete: Cascade)
  businessRecord    BusinessRecord?       @relation(fields: [businessRecordId], references: [businessRecordId], onDelete: SetNull)
  documents         ApplicationDocument[]
  paymentReferences PaymentReference[]
  history           ApplicationHistory[]
  feeAssessment     FeeAssessment?
  permitIssuance    PermitIssuance?
  smsDeliveryLogs   SmsDeliveryLog[]
  inspections       Inspection[]

  @@index([applicantId, createdAt])
  @@index([applicantId, status])
}

enum PermitDocumentType {
  BUSINESS_PERMIT
  CLOSURE_CERTIFICATE
}

enum InspectionComplianceStatus {
  PENDING_REVIEW
  COMPLIANT
  NON_COMPLIANT
}

enum InspectionStatus {
  COMPLIANT
  NON_COMPLIANT
  DH_VERIFICATION_PENDING
  VERIFIED_COMPLIANT
  VERIFIED_NON_COMPLIANT
  REVOCATION_REVIEW
  REVOCATION_DENIED
  REVOKED
}

enum RevocationDecision {
  APPROVED
  DENIED
}

enum JitChecklistResponse {
  YES
  NO
  COMPLIANT
  NON_COMPLIANT
  NOT_APPLICABLE
}

enum JitChecklistDepartment {
  BPLO
  ZONING_PLANNING
  ENGINEERING
  FIRE_SAFETY
  HEALTH_SANITARY
  ENVIRONMENT
  TREASURER_ASSESSMENT
  DECLARATION_VERIFICATION
}

model Inspection {
  inspectionId                    String                     @id @default(cuid())
  businessRecordId                String
  applicationId                   String?
  inspectorId                     String
  complianceStatus                InspectionComplianceStatus
  status                          InspectionStatus
  comment                         String?
  evidenceFileName                String?
  evidenceStoragePath             String?
  evidenceBucket                  String?
  evidenceMimeType                String?
  evidenceSizeBytes               Int?
  revocationDecision              RevocationDecision?
  revocationRecommendationRemarks String?
  revocationRemarks               String?
  decidedById                     String?
  decidedAt                       DateTime?
  revocationSettledAt             DateTime?
  revocationSettlementRemarks     String?
  revocationSettledById           String?
  nonComplianceType               NonComplianceType?
  violationSeverity               ViolationSeverity?
  isSettled                       Boolean                    @default(false)
  settledAt                       DateTime?
  settlementRemarks               String?
  settledById                     String?
  deadlineAt                      DateTime?
  autoClosed                      Boolean                    @default(false)
  forcedClosure                   Boolean                    @default(false)
  forcedClosureAt                 DateTime?
  forcedClosureById               String?
  complianceCaseStatus            ComplianceCaseStatus       @default(NONE)
  createdAt                       DateTime                   @default(now())
  updatedAt                       DateTime                   @updatedAt

  businessRecord      BusinessRecord            @relation(fields: [businessRecordId], references: [businessRecordId], onDelete: Cascade)
  application         BusinessApplication?      @relation(fields: [applicationId], references: [businessApplicationId], onDelete: SetNull)
  inspector           User                      @relation("InspectionInspector", fields: [inspectorId], references: [userId], onDelete: Restrict)
  decidedBy           User?                     @relation("InspectionDecider", fields: [decidedById], references: [userId], onDelete: SetNull)
  revocationSettledBy User?                     @relation("InspectionRevocationSettledBy", fields: [revocationSettledById], references: [userId], onDelete: SetNull)
  settledBy           User?                     @relation("InspectionSettledBy", fields: [settledById], references: [userId], onDelete: SetNull)
  forcedClosureBy     User?                     @relation("InspectionForcedClosureBy", fields: [forcedClosureById], references: [userId], onDelete: SetNull)
  checklistItems      InspectionChecklistItem[]

  @@index([businessRecordId, createdAt])
  @@index([applicationId, createdAt])
  @@index([inspectorId, createdAt])
  @@index([decidedById, createdAt])
  @@index([status, createdAt])
  @@index([revocationSettledAt, createdAt])
  @@index([complianceCaseStatus, createdAt])
  @@index([settledAt, createdAt])
  @@index([forcedClosureAt, createdAt])
}

model InspectionChecklistItem {
  inspectionChecklistItemId String                 @id @default(cuid())
  inspectionId              String
  departmentKey             JitChecklistDepartment
  question                  String
  response                  JitChecklistResponse
  remarks                   String?
  evidenceFileName          String?
  evidenceStoragePath       String?
  evidenceBucket            String?
  evidenceMimeType          String?
  evidenceSizeBytes         Int?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  inspection Inspection @relation(fields: [inspectionId], references: [inspectionId], onDelete: Cascade)

  @@unique([inspectionId, departmentKey])
  @@index([inspectionId])
}

enum PermitIssuanceStatus {
  PREPARED
  FOR_RELEASE
  RELEASED
}

model PermitIssuance {
  permitIssuanceId String               @id @default(cuid())
  applicationId    String               @unique
  documentNumber   String               @unique
  documentType     PermitDocumentType
  status           PermitIssuanceStatus @default(PREPARED)
  issuedAt         DateTime             @default(now())
  releasedAt       DateTime?
  preparedById     String
  releasedById     String?
  documentPath     String?
  remarks          String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  application BusinessApplication @relation(fields: [applicationId], references: [businessApplicationId], onDelete: Cascade)
  preparedBy  User                @relation("PermitPreparedBy", fields: [preparedById], references: [userId], onDelete: Restrict)
  releasedBy  User?               @relation("PermitReleasedBy", fields: [releasedById], references: [userId], onDelete: SetNull)

  @@index([status])
  @@index([applicationId, status])
}

model ApplicationDocument {
  applicationDocumentId String                   @id @default(cuid())
  applicationId         String
  documentName          String
  fileName              String
  storagePath           String
  bucket                String?
  filePath              String?
  originalName          String?
  mimeType              String
  sizeBytes             Int
  fileSize              Int?
  uploadedAt            DateTime                 @default(now())
  validationStatus      DocumentValidationStatus @default(PENDING_REVIEW)
  validationRemarks     String?
  validatedAt           DateTime?
  validatedById         String?

  application BusinessApplication @relation(fields: [applicationId], references: [businessApplicationId], onDelete: Cascade)
  validatedBy User?               @relation("DocumentValidatedBy", fields: [validatedById], references: [userId], onDelete: SetNull)

  @@index([applicationId])
}

model ApplicationHistory {
  applicationHistoryId String             @id @default(cuid())
  applicationId        String
  actorId              String?
  actorRole            Role?
  fromStatus           ApplicationStatus?
  toStatus             ApplicationStatus
  remarks              String?
  createdAt            DateTime           @default(now())

  application BusinessApplication @relation(fields: [applicationId], references: [businessApplicationId], onDelete: Cascade)
  actor       User?               @relation("HistoryActor", fields: [actorId], references: [userId], onDelete: SetNull)

  @@index([applicationId, createdAt])
}

enum FeeAssessmentStatus {
  DRAFT
  GENERATED
}

enum PaymentReferenceStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentSettlementStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PaymentFrequency {
  ANNUAL
  BI_ANNUAL
  QUARTERLY
}

enum SmsDeliveryStatus {
  SKIPPED
  SENT
  FAILED
}

model SmsDeliveryLog {
  smsDeliveryLogId String            @id @default(cuid())
  applicationId    String
  applicantId      String?
  phoneNumber      String?
  provider         String
  status           SmsDeliveryStatus
  messageBody      String
  providerResponse String?
  createdAt        DateTime          @default(now())

  application BusinessApplication @relation(fields: [applicationId], references: [businessApplicationId], onDelete: Cascade)
  applicant   User?               @relation("SmsDeliveryLogApplicant", fields: [applicantId], references: [userId], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@index([applicantId, createdAt])
  @@index([status, createdAt])
}

model FeeAssessment {
  feeAssessmentId           String                  @id @default(cuid())
  applicationId             String                  @unique
  assessmentNumber          String                  @unique
  status                    FeeAssessmentStatus     @default(DRAFT)
  paymentFrequency          PaymentFrequency        @default(ANNUAL)
  annualAssessedAmount      Decimal                 @default(0)
  releasePaymentAmount      Decimal                 @default(0)
  paymentStatus             PaymentSettlementStatus @default(UNPAID)
  mayorsPermitFee           Decimal                 @default(0)
  regulatoryFees            Decimal                 @default(0)
  additionalCharges         Decimal                 @default(0)
  penalties                 Decimal                 @default(0)
  surcharge                 Decimal                 @default(0)
  interest                  Decimal                 @default(0)
  closurePaymentDues        Decimal                 @default(0)
  closureCertificateFee     Decimal                 @default(0)
  otherCharges              Decimal                 @default(0)
  totalAmount               Decimal                 @default(0)
  remarks                   String?
  computedById              String?
  generatedAt               DateTime?
  reassessmentRequestedAt   DateTime?
  reassessmentRequestedById String?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  application             BusinessApplication     @relation(fields: [applicationId], references: [businessApplicationId], onDelete: Cascade)
  computedBy              User?                   @relation("AssessmentComputedBy", fields: [computedById], references: [userId], onDelete: SetNull)
  reassessmentRequestedBy User?                   @relation("FeeAssessmentReassessmentRequestedBy", fields: [reassessmentRequestedById], references: [userId], onDelete: SetNull)
  lineItems               FeeAssessmentLineItem[]

  @@index([applicationId])
  @@index([reassessmentRequestedAt])
}

model FeeAssessmentLineItem {
  feeAssessmentLineItemId String        @id @default(cuid())
  feeAssessmentId         String
  description             String
  amount                  Decimal       @default(0)
  sortOrder               Int           @default(0)
  isSystemGenerated       Boolean       @default(false)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  feeAssessment FeeAssessment @relation(fields: [feeAssessmentId], references: [feeAssessmentId], onDelete: Cascade)

  @@index([feeAssessmentId, sortOrder])
}

model PaymentReference {
  paymentReferenceId String                 @id @default(cuid())
  applicationId      String
  transactionNumber  String                 @unique
  paymentDate        DateTime
  proofFileName      String
  proofStoragePath   String
  proofBucket        String?
  proofMimeType      String
  proofSizeBytes     Int
  status             PaymentReferenceStatus @default(PENDING)
  reviewerRemarks    String?
  submittedAt        DateTime               @default(now())
  reviewedAt         DateTime?
  reviewedById       String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  application BusinessApplication @relation(fields: [applicationId], references: [businessApplicationId], onDelete: Cascade)
  reviewedBy  User?               @relation("PaymentReviewedBy", fields: [reviewedById], references: [userId], onDelete: SetNull)

  @@index([applicationId, submittedAt])
  @@index([status, submittedAt])
}

model FeeConfigurationItem {
  feeConfigurationItemId String   @id @default(cuid())
  category               String
  classification         String
  amount                 Decimal  @default(0)
  isActive               Boolean  @default(true)
  updatedById            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  updatedBy User? @relation("FeeConfigUpdatedBy", fields: [updatedById], references: [userId], onDelete: SetNull)

  @@unique([category, classification])
  @@index([category, isActive])
}

model SystemFeeSetting {
  systemFeeSettingId          String    @id @default(cuid())
  renewalSurchargePercent     Float     @default(25)
  monthlyInterestPercent      Float     @default(2)
  liquorTobaccoAddOnPercent   Float     @default(25)
  powerDistributionFixedFee   Decimal   @default(10000)
  privatePortFixedFee         Decimal   @default(50000)
  jitPortalEnabled            Boolean   @default(true)
  jitInspectionCycleStartedAt DateTime?
  updatedById                 String?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  updatedBy User? @relation("SystemFeeSettingUpdatedBy", fields: [updatedById], references: [userId], onDelete: SetNull)
}

model RenewalExtension {
  renewalExtensionId String   @id @default(cuid())
  startDate          DateTime
  endDate            DateTime
  isActive           Boolean  @default(true)
  waiveSurcharge     Boolean  @default(true)
  waiveInterest      Boolean  @default(false)
  remarks            String?
  updatedById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  updatedBy User? @relation("RenewalExtensionUpdatedBy", fields: [updatedById], references: [userId], onDelete: SetNull)

  @@index([isActive, startDate, endDate])
}

enum JitNoPermitTicketStatus {
  OPEN
  RESOLVED
}

model JitNoPermitRecord {
  jitNoPermitRecordId String                  @id @default(cuid())
  ticketNumber        String                  @unique
  ticketStatus        JitNoPermitTicketStatus @default(OPEN)
  businessName        String
  personAttended      String
  lineOfBusiness      String
  findings            String
  requiredAction      String
  remarks             String?
  latitude            Float
  longitude           Float
  address             String?
  contactPhone        String?
  contactEmail        String?
  inspectingOffice    String?
  notifiedAt          DateTime?
  notificationStatus  String?
  notificationChannel String?
  createdById         String
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  createdBy User @relation("JitNoPermitRecordCreatedBy", fields: [createdById], references: [userId], onDelete: Restrict)

  @@index([createdById, createdAt])
  @@index([businessName])
  @@index([createdAt])
  @@index([ticketStatus, businessName])
  @@index([ticketStatus, latitude, longitude])
}

model AuditLog {
  auditLogId         String   @id @default(cuid())
  actorId            String?
  actorName          String?
  actorRole          String?
  action             String
  module             String
  entityType         String
  entityId           String?
  applicationId      String?
  businessRecordId   String?
  inspectionId       String?
  paymentReferenceId String?
  documentId         String?
  beforeStatus       String?
  afterStatus        String?
  description        String?
  metadata           Json?
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([applicationId, createdAt])
  @@index([businessRecordId, createdAt])
  @@index([action, createdAt])
  @@index([module, createdAt])
  @@index([entityType, createdAt])
  @@index([createdAt])
}

model PasswordResetOtp {
  passwordResetOtpId String    @id @default(cuid())
  email              String
  otpHash            String
  expiresAt          DateTime
  verifiedAt         DateTime?
  usedAt             DateTime?
  attempts           Int       @default(0)
  createdAt          DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}
