{
  "name": "ebpls",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack && node -e \"require('fs').mkdirSync('.next',{recursive:true}); require('fs').writeFileSync('.next/lock','')\"",
    "vercel-build": "npm run build",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:cases": "tsx scripts/run-test-cases.ts --suite=usecases",
    "test:cases:all": "tsx scripts/run-test-cases.ts --suite=all",
    "test:cases:smoke": "tsx scripts/run-test-cases.ts --suite=smoke",
    "test:cases:list": "tsx scripts/run-test-cases.ts --list",
    "test:katalon:auth": "playwright test e2e/katalon-auth.spec.ts --reporter=list",
    "test:blackbox": "playwright test --config playwright.blackbox.config.ts --reporter=list",
    "test:blackbox:ui": "tsx scripts/run-blackbox-ui-suite.ts",
    "test:blackbox:ui:update": "tsx scripts/update-blackbox-ui-checklist.ts",
    "test:blackbox:interactive": "playwright test --config playwright.blackbox.config.ts --ui",
    "test:blackbox:headed": "playwright test --config playwright.blackbox.config.ts --headed",
    "test:blackbox:report": "tsx scripts/generate-blackbox-test-case-report.ts",
    "test:whitebox": "vitest run --config vitest.whitebox.config.ts",
    "test:whitebox:coverage": "vitest run --config vitest.whitebox.config.ts --coverage",
    "test:whitebox:db": "tsx scripts/whitebox-db-tests.ts",
    "test:whitebox:full": "tsx scripts/run-whitebox-suite.ts",
    "test:whitebox:report": "tsx scripts/generate-whitebox-detailed-report.ts",
    "test:whitebox:thesis": "tsx scripts/generate-whitebox-thesis-tables.ts",
    "test:whitebox:174": "tsx scripts/scan-whitebox-174.ts",
    "test:whitebox:qa-report": "tsx scripts/generate-qa-test-case-report.ts",
    "test:workflow": "vitest run --config vitest.preserved.config.ts src/lib/__tests__/workflow",
    "test:unit-extended": "vitest run --config vitest.preserved.config.ts src/lib/__tests__/unit-extended",
    "test:preserved": "vitest run --config vitest.preserved.config.ts",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:check": "tsx scripts/check-db-connection.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate:supabase": "tsx scripts/migrate-to-supabase.ts",
    "db:setup:storage": "tsx scripts/setup-supabase-storage.ts",
    "db:migrate:storage": "tsx scripts/migrate-local-uploads-to-supabase.ts",
    "db:studio": "prisma studio",
    "verify:security": "tsx scripts/verify-security-hardening.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "7.8.0",
    "@supabase/supabase-js": "^2.56.0",
    "@types/leaflet": "^1.9.21",
    "bcryptjs": "^3.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^7.0.13",
    "pg": "^8.13.3",
    "prisma": "7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.1",
    "resend": "^4.8.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^1.6.1",
    "cypress": "^16.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^1.1.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "nodemailer": "^7.0.13"
  }
}
